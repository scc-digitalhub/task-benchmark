{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Hugging Face Image Classification",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/image_classification/huggingface/huggingface_image_classification.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Deploy TVM models",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/tvm/deploy_dh.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
            }
        },
        {
            "name": "Benchmark TVM models",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/tvm/benchmark_dh_tvm.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "OPEN_INFERENCE_LOCAL_PORT": "8000",
                "OPEN_INFERENCE_USE_PORT_FORWARD": "true",
                "DHCLI_HOME": "C:/Users/palan/Documents/Tools/dhcli"
            }
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}