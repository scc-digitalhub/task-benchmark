FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1

RUN apt-get update \
	&& apt-get install -y --no-install-recommends libgomp1 \
	&& rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --no-deps --index-url https://download.pytorch.org/whl/cpu torch torchvision \
	&& pip install --no-cache-dir --index-url https://pypi.org/simple \
		"detectors==0.1.11" "timm==0.9.16"

WORKDIR /workspace
COPY server_timm.py /workspace/server_timm.py

CMD ["python", "/workspace/server_timm.py"]
